{
  "functions": {
    "api/order-confirm.js": {
      "includeFiles": "private-products/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/success.html",
      "destination": "/public/success.html"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/public/assets/$1"
    },
    {
      "source": "/robots.txt",
      "destination": "/public/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/public/sitemap.xml"
    },
    {
      "source": "/a-ya-vse-plakala-saxophone.html",
      "destination": "/a-ya-vse-plakala-saxophone.html"
    },
    {
      "source": "/enkarapista-saxophone.html",
      "destination": "/enkarapista-saxophone.html"
    },
    {
      "source": "/zatsiluyu-saxophone.html",
      "destination": "/zatsiluyu-saxophone.html"
    }
  ],
  "redirects": [
    {
      "source": "/a-ya-vse-plakala-saxophone",
      "destination": "/a-ya-vse-plakala-saxophone.html",
      "permanent": true
    },
    {
      "source": "/enkarapista-saxophone",
      "destination": "/enkarapista-saxophone.html",
      "permanent": true
    },
    {
      "source": "/zatsiluyu-saxophone",
      "destination": "/zatsiluyu-saxophone.html",
      "permanent": true
    }
  ]
}